---
// Página Servicios: un bloque por servicio, cada uno con su ancla (/servicios/#paid-media, etc.).
import { routes, type Lang } from "../i18n/ui";
import { services } from "../data/services";

interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  es: {
    kicker: "Servicios",
    title: "Cinco servicios, un solo equipo.",
    lede: "No trabajamos por piezas sueltas. El mismo equipo piensa la estrategia, crea, lanza y mide, así nada se pierde entre una cosa y la otra.",
    includes: "Incluye",
    ask: "Pregúntanos por esto",
    closeTitle: "¿No sabes por dónde empezar?",
    closeText: "Cuéntanos qué quieres lograr y te decimos qué combinación tiene sentido para tu marca.",
    closeCta: "Empieza tu proyecto",
  },
  en: {
    kicker: "Services",
    title: "Five services, one team.",
    lede: "We don't work in disconnected pieces. The same team thinks the strategy, creates, launches and measures, so nothing gets lost in between.",
    includes: "Includes",
    ask: "Ask us about this",
    closeTitle: "Not sure where to start?",
    closeText: "Tell us what you want to achieve and we'll tell you which mix makes sense for your brand.",
    closeCta: "Start your project",
  },
}[lang];
---
<section class="page-hero tone-dark edge">
  <p class="t-label">{copy.kicker}</p>
  <h1 class="t-mega">{copy.title}</h1>
  <p class="t-lead t-mute">{copy.lede}</p>
  <nav class="jump" aria-label={copy.kicker}>
    {services.map((s) => <a href={`#${s.slug}`}>{s.name[lang]}</a>)}
  </nav>
</section>

{services.map((s, i) => (
  <section id={s.slug} class="service tone-dark section edge">
    <div class="grid">
      <span class="t-label service-num">{String(i + 1).padStart(2, "0")}</span>
      <div class="service-main">
        <h2 class="t-display">{s.name[lang]}</h2>
        <p class="t-h2 service-line">{s.line[lang]}</p>
      </div>
      <div class="service-body">
        <p class="t-lead t-mute">{s.body[lang]}</p>
        <p class="t-label">{copy.includes}</p>
        <ul class="service-items">{s.items[lang].map((it) => <li>{it}</li>)}</ul>
        <a href={routes.contact[lang]} class="link-arrow" data-contact-open>{copy.ask} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
))}

<section class="tone-dark section edge closing">
  <h2 class="t-mega">{copy.closeTitle}</h2>
  <p class="t-lead t-mute">{copy.closeText}</p>
  <a href={routes.contact[lang]} class="btn btn-green" data-contact-open>{copy.closeCta}</a>
</section>

<style>
  .page-hero { min-height: 80svh; display: flex; flex-direction: column; justify-content: flex-end; gap: 1.25rem;
    padding-top: calc(var(--bar-h) + 3rem); padding-bottom: clamp(48px, 8vh, 96px); }
  .page-hero h1 { margin-left: -.04em; max-width: 11ch; }
  .page-hero .t-lead { max-width: 46ch; }
  .jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .jump a { padding: .55em 1em; border: 1px solid var(--line); border-radius: 999px; font-size: .9375rem;
    transition: background-color .25s var(--ease-out), color .25s var(--ease-out), border-color .25s var(--ease-out); }
  .jump a:hover { background: var(--green); color: var(--black); border-color: var(--green); }

  .service { border-top: 1px solid var(--line); scroll-margin-top: var(--bar-h); }
  .service-num { grid-column: 1 / -1; color: var(--green); }
  .service-main { grid-column: 1 / -1; display: grid; gap: 1rem; margin-block: 1rem 2rem; }
  .service-main .t-display { font-size: clamp(2.4rem, 8.4vw, 9.5rem); overflow-wrap: anywhere; }
  .service-line { max-width: 24ch; color: var(--text-mute); }
  .service-body { grid-column: 1 / -1; display: grid; gap: 1.25rem; align-content: start; }
  .service-body .t-lead { max-width: 44ch; }
  .service-items { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .75rem; }
  .service-items li { padding: .5em .95em; border: 1px solid var(--line); border-radius: 999px; font-size: .9375rem; }
  @media (min-width: 1000px) {
    .service-num { grid-column: 1 / 2; padding-top: 1.2em; }
    .service-main { grid-column: 2 / 8; margin: 0; }
    .service-body { grid-column: 8 / -1; padding-top: 1.2em; }
  }

  .closing { display: grid; gap: 1.5rem; justify-items: start; border-top: 1px solid var(--line); }
  .closing h2 { margin-left: -.04em; max-width: 12ch; }
  .closing .t-lead { max-width: 40ch; }
</style>
