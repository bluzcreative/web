---
// Página Nosotros: manifiesto, cómo trabajamos (concreto y práctico) y con quiénes trabajamos.
// BORRADOR: el manifiesto y los datos operativos (tiempos, reuniones, reportes, herramientas, horarios)
// son una propuesta inicial y deben confirmarse con Bluz antes de publicar.
import Marquee from "../components/site/Marquee.astro";
import { routes, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  es: {
    kicker: "Nosotros",
    manifesto: [
      "Menos ruido. Más luz.",
      "Medimos lo que importa, no lo que se ve bien en un gráfico.",
      "Estrategia, creatividad y tecnología en el mismo equipo.",
      "Preferimos una conversación honesta a un reporte inflado.",
      "Si algo se puede automatizar, lo automatizamos.",
    ],
    howKicker: "Cómo trabajamos",
    howTitle: "Lo práctico, sin vueltas.",
    steps: [
      ["Brief", "Una reunión y un cuestionario para entender tu negocio, tus objetivos y lo que ya probaste."],
      ["Estrategia", "Te presentamos el plan: qué hacemos, en qué canales, con qué presupuesto y cómo vamos a medirlo."],
      ["Producción", "Creamos las piezas, las campañas, la web o las automatizaciones según el plan."],
      ["Aprobación", "Revisas todo en una grilla o en un enlace de vista previa antes de que salga."],
      ["Lanzamiento", "Publicamos, activamos campañas y dejamos todo conectado y documentado."],
      ["Medición", "Revisamos resultados, ajustamos y te contamos qué aprendimos."],
    ],
    facts: [
      ["Tiempo de respuesta", "Respondemos mensajes dentro del mismo día hábil."],
      ["Reuniones", "Una reunión de arranque y una de revisión al mes. En lanzamientos, seguimiento semanal."],
      ["Reportes", "Un reporte mensual con los números que importan y qué haremos con ellos. En paid media, también resumen semanal."],
      ["Herramientas", "Meta Business, Google Ads, Google Workspace, Notion, Figma, Canva, Make y WhatsApp o Slack para el día a día."],
      ["Idiomas", "Trabajamos en español y en inglés."],
      ["Husos horarios", "Nuestro equipo trabaja en horario de las Américas y coordina reuniones con clientes en otros husos, como Australia."],
    ],
    whoKicker: "Con quiénes trabajamos",
    whoTitle: "Worldwide.",
    whoText: "Marcas de distintos países e industrias: tecnología, construcción, gastronomía, bienestar, logística y más.",
    closeTitle: "¿Trabajamos juntos?",
    closeCta: "Empieza tu proyecto",
  },
  en: {
    kicker: "About",
    manifesto: [
      "Less noise. More light.",
      "We measure what matters, not what looks good on a chart.",
      "Strategy, creativity and technology on the same team.",
      "We'd rather have an honest conversation than an inflated report.",
      "If something can be automated, we automate it.",
    ],
    howKicker: "How we work",
    howTitle: "The practical stuff, straight up.",
    steps: [
      ["Brief", "A call and a questionnaire to understand your business, your goals and what you've already tried."],
      ["Strategy", "We present the plan: what we'll do, on which channels, with what budget and how we'll measure it."],
      ["Production", "We create the pieces, campaigns, website or automations based on the plan."],
      ["Approval", "You review everything in a content grid or a preview link before it goes live."],
      ["Launch", "We publish, switch campaigns on and leave everything connected and documented."],
      ["Measurement", "We review results, adjust and tell you what we learned."],
    ],
    facts: [
      ["Response time", "We reply to messages within the same business day."],
      ["Meetings", "A kickoff call and a monthly review. During launches, weekly check-ins."],
      ["Reports", "A monthly report with the numbers that matter and what we'll do about them. For paid media, a weekly summary too."],
      ["Tools", "Meta Business, Google Ads, Google Workspace, Notion, Figma, Canva, Make, and WhatsApp or Slack day to day."],
      ["Languages", "We work in English and Spanish."],
      ["Time zones", "Our team works on Americas hours and schedules calls with clients in other time zones, such as Australia."],
    ],
    whoKicker: "Who we work with",
    whoTitle: "Worldwide.",
    whoText: "Brands across countries and industries: technology, construction, food, wellness, logistics and more.",
    closeTitle: "Shall we work together?",
    closeCta: "Start your project",
  },
}[lang];
---
<section class="manifesto tone-dark edge" aria-labelledby="manifesto-title">
  <p class="t-label" id="manifesto-title">{copy.kicker}</p>
  <ol class="manifesto-list">
    {copy.manifesto.map((m) => <li class="t-h1 lit-line" data-lit>{m}</li>)}
  </ol>
</section>

<section id="como-trabajamos" class="how tone-dark section edge">
  <div class="how-head">
    <p class="t-label">{copy.howKicker}</p>
    <h2 class="t-mega">{copy.howTitle}</h2>
  </div>
  <ol class="steps">
    {copy.steps.map(([name, text], i) => (
      <li>
        <span class="t-label step-num">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="t-h2">{name}</h3>
        <p class="t-mute">{text}</p>
      </li>
    ))}
  </ol>
  <dl class="facts">
    {copy.facts.map(([k, v]) => (
      <div><dt class="t-label">{k}</dt><dd>{v}</dd></div>
    ))}
  </dl>
</section>

<section class="who tone-dark section">
  <div class="edge who-head">
    <p class="t-label">{copy.whoKicker}</p>
    <h2 class="t-mega">{copy.whoTitle}</h2>
    <p class="t-lead t-mute">{copy.whoText}</p>
  </div>
  <Marquee label={copy.whoKicker} />
</section>

<section class="tone-dark section edge closing">
  <a href={routes.contact[lang]} class="t-mega closing-title" data-contact-open>{copy.closeTitle}</a>
  <a href={routes.contact[lang]} class="btn btn-green" data-contact-open>{copy.closeCta}</a>
</section>

<style>
  .manifesto { padding-top: calc(var(--bar-h) + clamp(48px, 12vh, 140px)); padding-bottom: var(--section); display: grid; gap: 2rem; }
  .manifesto-list { list-style: none; padding: 0; display: grid; gap: clamp(16px, 3vh, 40px); }
  .manifesto-list li { --lit: 1; max-width: 22ch; font-size: clamp(2rem, 5.4vw, 6rem);
    color: color-mix(in srgb, var(--text) calc(var(--lit) * 100%), var(--text-dim)); }

  .how { border-top: 1px solid var(--line); scroll-margin-top: var(--bar-h); }
  .how-head { display: grid; gap: 1rem; margin-bottom: clamp(40px, 6vw, 96px); }
  .how-head h2 { margin-left: -.04em; max-width: 12ch; }
  .steps { list-style: none; padding: 0; display: grid; gap: var(--gutter); }
  .steps li { display: grid; gap: .75rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .step-num { color: var(--green); }
  @media (min-width: 700px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(3, 1fr); row-gap: 3rem; } }
  .facts { display: grid; gap: 0 var(--gutter); margin-top: clamp(56px, 8vw, 120px); }
  .facts div { display: grid; gap: .5rem; padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .facts dd { font-size: var(--fs-lead); line-height: 1.45; max-width: 40ch; }
  @media (min-width: 900px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .facts div { grid-template-columns: 1fr 2fr; align-items: baseline; }
  }

  .who { border-top: 1px solid var(--line); }
  .who-head { display: grid; gap: 1rem; margin-bottom: clamp(32px, 5vw, 72px); }
  .who-head h2 { margin-left: -.04em; }
  .who-head .t-lead { max-width: 44ch; }

  .closing { display: grid; gap: 2rem; justify-items: start; border-top: 1px solid var(--line); }
  .closing-title { margin-left: -.04em; max-width: 11ch; transition: color .4s var(--ease-out); }
  .closing-title:hover { color: var(--green); }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // Cada frase del manifiesto se enciende al cruzar la pantalla (sin JavaScript quedan encendidas)
    document.querySelectorAll<HTMLElement>("[data-lit]").forEach((el) => {
      gsap.fromTo(el, { "--lit": 0 }, { "--lit": 1, ease: "none", scrollTrigger: { trigger: el, start: "top 85%", end: "top 50%", scrub: true } });
    });
  }
</script>
