---
import { whatsappUrl } from "../data/brand";
import { t, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const clients = ["Rooties", "Lunetto", "Compremos En China", "Disergen", "Prophone", "X-Build", "Flatpack Container"];

const copy = {
  es: {
    kicker: "Bluz Creative · Caracas",
    titleA: "Estrategia, creatividad y ", titleEm: "tecnología", titleB: " para marcas listas para crecer.",
    sub: "Somos una agencia con base en Caracas que trabaja con empresas de Venezuela, Latinoamérica y otros mercados. Marketing, contenido, sistemas y producción audiovisual, todo en un mismo equipo.",
    aboutKicker: "Sobre Bluz",
    about: "En Bluz Creative combinamos estrategia, creatividad y tecnología para ayudar a los negocios a crecer de forma sostenible. Trabajamos con marcas que buscan fortalecer su presencia digital, ordenar sus procesos y construir sistemas que les permitan vender más sin perder el control de su operación.",
    doKicker: "Qué hacemos", doTitle: "Seis áreas, trabajando como un solo equipo.",
    areas: [
      ["Estrategia y Marketing", "Estrategia orientada a resultados."],
      ["Contenido y Redes Sociales", "Contenido que conecta y convierte."],
      ["Branding y Diseño", "Identidad visual y coherencia de marca."],
      ["Web y Presencia Digital", "Experiencias digitales a la medida."],
      ["Sistemas y Automatización", "Herramientas para operar mejor."],
      ["Producción Audiovisual", "Piezas visuales con impacto real."],
    ],
    whyKicker: "Por qué trabajar con nosotros", whyTitle: "Servicio integral, sin perder los detalles.",
    reasons: [
      ["Enfoque integral", "Estrategia, contenido, sistemas y ejecución en un mismo lugar."],
      ["Soluciones a la medida", "Cada negocio es distinto, así que trabajamos según tus objetivos reales."],
      ["Tecnología y automatización", "Sumamos herramientas que hacen que tu operación fluya mejor."],
      ["Acompañamiento cercano", "Construimos relaciones que duran más allá de un proyecto."],
    ],
    trust: "Marcas que confían en Bluz",
    countries: "Trabajamos con marcas de Venezuela, Estados Unidos, Australia y más.",
    finalTitle: "Construyamos juntos la próxima etapa de tu marca.",
  },
  en: {
    kicker: "Bluz Creative · Caracas",
    titleA: "Strategy, creativity and ", titleEm: "technology", titleB: " for brands ready to grow.",
    sub: "We're an agency based in Caracas, working with companies across Venezuela, Latin America and beyond. Marketing, content, systems and audiovisual production, all under one team.",
    aboutKicker: "About Bluz",
    about: "At Bluz Creative we combine strategy, creativity and technology to help businesses grow sustainably. We work with brands looking to strengthen their digital presence, organize their processes and build systems that let them sell more without losing control of their operation.",
    doKicker: "What we do", doTitle: "Six areas, working as one team.",
    areas: [
      ["Strategy and Marketing", "Results-driven strategy."],
      ["Content and Social Media", "Content that connects and converts."],
      ["Branding and Design", "Visual identity and brand consistency."],
      ["Web and Digital Presence", "Digital experiences built to fit."],
      ["Systems and Automation", "Tools to help you operate better."],
      ["Audiovisual Production", "Visual pieces with real impact."],
    ],
    whyKicker: "Why work with us", whyTitle: "Full-service, without losing the details.",
    reasons: [
      ["Full-service approach", "Strategy, content, systems and execution under one roof."],
      ["Tailored solutions", "Every business is different, so we work around your actual goals."],
      ["Technology and automation", "We bring in tools that make your operation run smoother."],
      ["Close, ongoing support", "We build relationships that last beyond a single project."],
    ],
    trust: "Brands that trust Bluz",
    countries: "We work with brands across Venezuela, the United States and Australia, and more.",
    finalTitle: "Let's build the next stage of your brand, together.",
  },
}[lang];
---
<section class="hero">
  <div class="container hero-inner">
    <span class="hero-rule" aria-hidden="true"></span>
    <p class="kicker">{copy.kicker}</p>
    <h1 class="hero-title">{copy.titleA}<em>{copy.titleEm}</em>{copy.titleB}</h1>
    <p class="hero-sub lede">{copy.sub}</p>
    <div class="hero-actions">
      <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary">{tr("cta.talk")}</a>
    </div>
  </div>
</section>

<section class="section section-green">
  <div class="container about-statement-block" data-reveal-group>
    <p class="kicker">{copy.aboutKicker}</p>
    <p class="about-statement">{copy.about}</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="kicker">{copy.doKicker}</p>
      <h2>{copy.doTitle}</h2>
    </div>
    <div class="grid-lines cols-3 grid-lines-pop" data-reveal-bento>
      {copy.areas.map(([title, desc], i) => (
        <div class="grid-cell">
          <span class="chip-num">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="grid-cell-title">{title}</h3>
          <p class="grid-cell-desc">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section-green">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="kicker">{copy.whyKicker}</p>
      <h2>{copy.whyTitle}</h2>
    </div>
    <div class="reasons-grid" data-reveal-group>
      {copy.reasons.map(([title, desc]) => (
        <div class="reason-card">
          <h3>{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-alt">
  <div class="container" data-reveal>
    <p class="eyebrow" style="margin-bottom:1.4rem;">{copy.trust}</p>
  </div>
  <div class="marquee" data-reveal>
    <div class="marquee-track">
      {clients.map((name) => <span class="marquee-item">{name}</span>)}
      {clients.map((name) => <span class="marquee-item" aria-hidden="true">{name}</span>)}
    </div>
  </div>
  <div class="container" style="padding-top:1.2rem;">
    <p class="mute" style="font-size:.9rem;">{copy.countries}</p>
  </div>
</section>

<section class="final-cta section-green">
  <div class="container final-cta-inner" data-reveal>
    <h2>{copy.finalTitle}</h2>
    <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary">{tr("cta.whatsapp")}</a>
  </div>
</section>
