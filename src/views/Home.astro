---
// Landing con scrolltelling: siete escenas, cada una lleva a otra parte de la web.
import { getCollection } from "astro:content";
import ProjectCard from "../components/site/ProjectCard.astro";
import Marquee from "../components/site/Marquee.astro";
import { routes, t, type Lang } from "../i18n/ui";
import { services } from "../data/services";
import { whatsappUrl } from "../data/brand";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const featured = (await getCollection("projects", (p) => p.data.featured && !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 4);

// Textos provisionales: frase del hero y manifiesto pendientes de definir con Bluz
const copy = {
  es: {
    hero: ["No seguimos", "fórmulas.", "Creamos la"], heroEm: "tuya",
    scroll: "Scroll",
    doKicker: "Qué hacemos",
    doFoot: "Cinco servicios, un solo equipo que los conecta.",
    doLink: "Ver servicios",
    workKicker: "El trabajo",
    workTitle: "Marcas que ya se ven distinto.",
    workLink: "Ver todo el trabajo",
    cardCta: "Ver proyecto",
    whoKicker: "Con quiénes",
    manifestoKicker: "Manifiesto",
    manifesto: "Menos ruido. Más luz.",
    manifestoLink: "Cómo trabajamos",
    closeTitle: "¿Hablamos?",
  },
  en: {
    hero: ["We don't follow", "formulas.", "We create"], heroEm: "yours",
    scroll: "Scroll",
    doKicker: "What we do",
    doFoot: "Five services, one team that connects them.",
    doLink: "See services",
    workKicker: "The work",
    workTitle: "Brands that already look different.",
    workLink: "See all work",
    cardCta: "View project",
    whoKicker: "Who we work with",
    manifestoKicker: "Manifesto",
    manifesto: "Less noise. More light.",
    manifestoLink: "How we work",
    closeTitle: "Let's talk.",
  },
}[lang];

const manifestoWords = copy.manifesto.split(" ");
---
<!-- 1. El impacto -->
<section class="hero tone-dark" data-hero>
  <!-- Aquí irá el reel de trabajos de Bluz; mientras tanto, fondo oscuro con luz verde que sigue al cursor -->
  <div class="hero-media" aria-hidden="true">
    <span class="hero-ambient"></span>
    <span class="hero-glow" data-glow></span>
  </div>
  <div class="hero-content edge" data-hero-content>
    <h1 class="t-mega hero-title" aria-label={`${copy.hero.join(" ")} ${copy.heroEm}.`}>
      <span class="line"><span>{copy.hero[0]}</span></span>
      <span class="line"><span>{copy.hero[1]}</span></span>
      <span class="line"><span>{copy.hero[2]} <em class="t-serif">{copy.heroEm}</em>.</span></span>
    </h1>
  </div>
</section>

<!-- 2. Qué hacemos: cada servicio se enciende con el scroll y lleva a Servicios -->
<section class="scene services tone-dark section edge">
  <div class="grid">
    <p class="t-label scene-label">{copy.doKicker}</p>
    <ul class="services-list">
      {services.map((s) => (
        <li>
          <a href={`${routes.services[lang]}#${s.slug}`} class="lit-word" data-lit>
            <span class="t-display">{s.name[lang]}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="scene-foot">
      <p class="t-lead t-mute">{copy.doFoot}</p>
      <a href={routes.services[lang]} class="link-arrow">{copy.doLink} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- 3. El trabajo: tarjetas que cobran vida y llevan a Trabajo -->
<section class="scene work tone-dark section edge">
  <div class="scene-head">
    <div>
      <p class="t-label">{copy.workKicker}</p>
      <h2 class="t-h1">{copy.workTitle}</h2>
    </div>
    <a href={routes.work[lang]} class="link-arrow">{copy.workLink} <span class="arr" aria-hidden="true">→</span></a>
  </div>
  <div class="work-grid">
    {featured.map((p) => <ProjectCard project={p} lang={lang} cta={copy.cardCta} />)}
  </div>
</section>

<!-- 4. Con quiénes: logos de clientes corriendo -->
<section class="scene who tone-dark">
  <Marquee label={copy.whoKicker} />
</section>

<!-- 5. El manifiesto: la frase se va escribiendo con el scroll, lleva a Nosotros -->
<section class="scene manifesto tone-dark edge" data-manifesto>
  <div class="manifesto-sticky">
    <p class="t-label">{copy.manifestoKicker}</p>
    <p class="t-h1 manifesto-text" aria-label={copy.manifesto}>
      {manifestoWords.map((w) => <span class="mw" aria-hidden="true">{w} </span>)}
    </p>
    <a href={`${routes.about[lang]}#como-trabajamos`} class="link-arrow">{copy.manifestoLink} <span class="arr" aria-hidden="true">→</span></a>
  </div>
</section>

<!-- 7. El cierre: abre el pop-up de contacto -->
<section class="scene closing tone-dark section edge">
  <a href={routes.contact[lang]} class="t-mega closing-title" data-contact-open>{copy.closeTitle}</a>
  <div class="closing-paths">
    <a href={routes.contact[lang]} class="path" data-contact-open>
      <span class="t-label">{tr("contact.form.kicker")}</span>
      <span class="t-h2">{tr("contact.form.title")} <span aria-hidden="true">→</span></span>
    </a>
    <a href={whatsappUrl(tr("contact.chat.message"))} target="_blank" rel="noopener" class="path">
      <span class="t-label">{tr("contact.chat.kicker")}</span>
      <span class="t-h2">{tr("contact.chat.title")} <span aria-hidden="true">↗</span></span>
    </a>
  </div>
</section>

<style>
  /* 1. Hero */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-start; overflow: hidden; }
  .hero-media { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(70% 60% at 50% 45%, #171717, var(--black) 75%); }
  .hero-ambient { position: absolute; inset: -20%;
    background: radial-gradient(35% 30% at 20% 80%, rgba(123,255,118,.10), transparent 70%);
    animation: drift 14s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate3d(-6%, 4%, 0) scale(1.08); } }
  .hero-glow { position: absolute; left: 0; top: 0; width: 70vmax; height: 70vmax; margin: -35vmax 0 0 -35vmax;
    border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(123,255,118,.30), rgba(123,255,118,.10) 45%, transparent);
    transform: translate(70vw, 30vh); will-change: transform; }
  .hero-content { position: relative; z-index: 1; width: 100%; padding-top: calc(var(--bar-h) + clamp(16px, 4vh, 48px)); padding-bottom: clamp(32px, 7vh, 80px); }
  .hero-title { font-size: clamp(3.2rem, 10.5vw, 12.5rem); line-height: 1; text-align: center; }
  @media (max-width: 699px) {
    /* Móvil: hero más bajo, frase más grande y centrada en el alto para que no quede aire de sobra */
    .hero { min-height: 72svh; align-items: center; }
    .hero-title { font-size: clamp(3.2rem, 15vw, 5rem); }
    .hero-content { padding-bottom: 0; }
  }
  .hero-title .line { display: block; overflow: hidden; padding-bottom: .24em; margin-bottom: -.24em; }
  .hero-title .line > span { display: block; }
  .hero-title em { color: var(--green); }

  /* Comunes de escena */
  .scene-label { grid-column: 1 / -1; margin-bottom: 1.5rem; }
  .scene-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: clamp(32px, 5vw, 72px); }
  .scene-head > div { display: grid; gap: 1rem; flex: 1 1 520px; }
  .scene-head h2 { max-width: 16ch; }
  .scene-foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-top: 2.5rem; }

  /* 2. Servicios */
  .services-list { grid-column: 1 / -1; }
  .services-list li { border-top: 1px solid var(--line); }
  .services-list li:last-child { border-bottom: 1px solid var(--line); }
  .lit-word {
    --lit: 1;
    display: block; padding-block: .25em .3em;
    color: color-mix(in srgb, var(--text) calc(var(--lit) * 100%), var(--text-dim));
    transition: color .35s var(--ease-out);
  }
  .lit-word .t-display { grid-column: 1; font-size: clamp(2rem, 8.4vw, 9.5rem); }
  .lit-word:hover, .lit-word:focus-visible { color: var(--green); }
  @media (min-width: 900px) {
    .scene-label { grid-column: 1 / 4; margin: .9em 0 0; }
    .services-list, .scene-foot { grid-column: 4 / -1; }
  }

  /* 3. Trabajo */
  .work-grid { display: grid; gap: clamp(48px, 6vw, 96px) var(--gutter); }
  @media (min-width: 700px) { .work-grid { grid-template-columns: 1fr 1fr; } .work-grid > :nth-child(even) { margin-top: 14vh; } }
  @media (min-width: 1200px) {
    .work-grid { grid-template-columns: repeat(3, 1fr); }
    .work-grid > :nth-child(even) { margin-top: 0; }
    .work-grid > :nth-child(3n + 2) { margin-top: 16vh; }
  }

  /* 4. Con quiénes */
  .who { padding-block: clamp(24px, 4vw, 64px); }

  /* 5. Manifiesto */
  .manifesto { height: 220vh; position: relative; }
  .manifesto-sticky { position: sticky; top: 0; min-height: 100svh; display: grid; align-content: center; gap: 2rem; padding-block: var(--bar-h); }
  .manifesto-text { max-width: 9ch; font-size: var(--fs-mega); line-height: .9; letter-spacing: -.055em; margin-left: -.04em; }
  .mw { --lit: 1; color: color-mix(in srgb, var(--text) calc(var(--lit) * 100%), var(--text-dim)); }

  /* 7. Cierre */
  .closing { min-height: 100svh; display: flex; flex-direction: column; justify-content: space-between; gap: 4rem; }
  .closing-title { display: block; margin-left: -.04em; transition: color .4s var(--ease-out); }
  .closing-title:hover { color: var(--green); }
  .closing-paths { display: grid; gap: var(--gutter); }
  @media (min-width: 900px) { .closing-paths { grid-template-columns: 1fr 1fr; } }
  .path { display: grid; gap: .75rem; padding: clamp(24px, 3vw, 48px); border: 1px solid var(--line);
    transition: background-color .35s var(--ease-out), color .35s var(--ease-out), border-color .35s var(--ease-out); }
  .path:hover { background: var(--green); color: var(--black); border-color: var(--green); }
  .path:hover .t-label { color: rgba(10,10,10,.7); }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const root = document.documentElement;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

  /* Luz verde que sigue al cursor */
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const glow = document.querySelector<HTMLElement>("[data-glow]");
  if (hero && glow && fine && !reduced) {
    const toX = gsap.quickTo(glow, "x", { duration: 1.2, ease: "power3.out" });
    const toY = gsap.quickTo(glow, "y", { duration: 1.2, ease: "power3.out" });
    gsap.set(glow, { x: innerWidth * 0.7, y: innerHeight * 0.3 });
    hero.addEventListener("pointermove", (e) => { const r = hero.getBoundingClientRect(); toX(e.clientX - r.left); toY(e.clientY - r.top); });
    hero.addEventListener("pointerleave", () => { toX(hero.offsetWidth * 0.7); toY(hero.offsetHeight * 0.3); });
  }

  /* Entrada del hero (después de la pantalla de carga, si la hay) */
  const heroIn = () => {
    if (reduced) return;
    gsap.from(".hero-title .line > span", { yPercent: 105, duration: 1.1, ease: "power4.out", stagger: 0.1 });
  };

  /* Pantalla de carga */
  const loader = document.querySelector<HTMLElement>("[data-loader]");
  if (loader && root.classList.contains("intro")) {
    const imgs = Array.from(loader.querySelectorAll<HTMLElement>("[data-loader-img]"));
    const count = loader.querySelector<HTMLElement>("[data-loader-count]")!;
    const frame = loader.querySelector<HTMLElement>("[data-loader-frame]")!;
    const texts = loader.querySelectorAll<HTMLElement>("[data-loader-text]");
    let i = 0;
    const flip = setInterval(() => {
      if (imgs.length < 2) return;
      imgs[i].classList.remove("is-on");
      i = (i + 1) % imgs.length;
      imgs[i].classList.add("is-on");
    }, 220);
    const counter = { v: 0 };
    const tl = gsap.timeline({
      onComplete: () => {
        root.classList.remove("intro");
        try { sessionStorage.setItem("bluz-intro", "1"); } catch { /* sin almacenamiento: se mostrará otra vez */ }
        ScrollTrigger.refresh();
      },
    });
    tl.to(counter, { v: 100, duration: 2.4, ease: "power2.inOut", onUpdate: () => { count.textContent = String(Math.round(counter.v)); } })
      .add(() => {
        clearInterval(flip);
      })
      .to(texts, { yPercent: 110, duration: 0.5, ease: "power3.in", stagger: 0.05 })
      .to(frame, {
        width: () => innerWidth, height: () => innerHeight, duration: 1.1, ease: "expo.inOut",
        onStart: () => {
          const r = frame.getBoundingClientRect();
          gsap.set(frame, { position: "fixed", left: r.left, top: r.top, width: r.width, height: r.height, aspectRatio: "auto" });
          gsap.to(frame, { left: 0, top: 0, duration: 1.1, ease: "expo.inOut" });
        },
      }, "-=0.1")
      .to(frame, { opacity: 0, duration: 0.6, ease: "power2.out" }, "-=0.15")
      .add(heroIn, "-=0.45")
      .to(loader, { opacity: 0, duration: 0.4, ease: "power2.out" }, "-=0.3");
  } else {
    heroIn();
  }

  if (!reduced) {
    /* Escena 1: el texto del hero baja mientras se hace scroll */
    gsap.to("[data-hero-content]", {
      y: () => (document.querySelector<HTMLElement>("[data-hero]")?.offsetHeight ?? innerHeight) * 0.6, ease: "none",
      scrollTrigger: { trigger: "[data-hero]", start: "top top", end: "bottom top", scrub: true, invalidateOnRefresh: true },
    });

    /* Escena 2: cada servicio se enciende al cruzar la pantalla (sin JavaScript quedan encendidos) */
    document.querySelectorAll<HTMLElement>("[data-lit]").forEach((el) => {
      gsap.fromTo(el, { "--lit": 0 }, { "--lit": 1, ease: "none", scrollTrigger: { trigger: el, start: "top 85%", end: "top 45%", scrub: true } });
    });

    /* Escena 5: el manifiesto se escribe palabra por palabra mientras la sección queda fija */
    const words = document.querySelectorAll<HTMLElement>("[data-manifesto] .mw");
    if (words.length) {
      gsap.fromTo(words, { "--lit": 0 }, {
        "--lit": 1, ease: "none", stagger: 0.5,
        scrollTrigger: { trigger: "[data-manifesto]", start: "top top", end: "bottom bottom", scrub: true },
      });
    }

    /* Escena 7: el cierre crece al entrar */
    gsap.from(".closing-title", { scale: 0.9, transformOrigin: "left bottom", ease: "none",
      scrollTrigger: { trigger: ".closing", start: "top bottom", end: "top 30%", scrub: true } });
  }
</script>
