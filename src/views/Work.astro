---
// Página Trabajo: grilla de proyectos con tarjetas animadas y lista de otros trabajos.
import { getCollection } from "astro:content";
import ProjectCard from "../components/site/ProjectCard.astro";
import { routes, type Lang } from "../i18n/ui";
import { moreWork } from "../data/clients";

interface Props { lang: Lang }
const { lang } = Astro.props;

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);

const copy = {
  es: {
    kicker: "Trabajo",
    title: "Marcas que ya se ven distinto.",
    lede: "Una selección de proyectos de paid media, contenido, branding, web y automatización. Pasa el cursor para ver más de cada uno.",
    cta: "Ver proyecto",
    moreKicker: "Más trabajo",
    moreTitle: "Otras marcas con las que hemos trabajado.",
    closeTitle: "¿La próxima es tu marca?",
    closeCta: "Empieza tu proyecto",
  },
  en: {
    kicker: "Work",
    title: "Brands that already look different.",
    lede: "A selection of paid media, content, branding, web and automation projects. Hover to see more of each one.",
    cta: "View project",
    moreKicker: "More work",
    moreTitle: "Other brands we've worked with.",
    closeTitle: "Is your brand next?",
    closeCta: "Start your project",
  },
}[lang];
---
<section class="page-hero tone-dark edge">
  <p class="t-label">{copy.kicker}</p>
  <h1 class="t-mega">{copy.title}</h1>
  <p class="t-lead t-mute">{copy.lede}</p>
</section>

<section class="tone-dark edge work">
  <div class="work-grid">
    {projects.map((p, i) => <ProjectCard project={p} lang={lang} cta={copy.cta} eager={i < 2} sizes="(min-width: 900px) 50vw, 100vw" />)}
  </div>
</section>

<section class="tone-dark section edge more">
  <div class="grid">
    <div class="more-head">
      <p class="t-label">{copy.moreKicker}</p>
      <h2 class="t-h2">{copy.moreTitle}</h2>
    </div>
    <ul class="more-list">
      {moreWork.map((w) => (
        <li>
          <span class="t-h2">{w.client}</span>
          <span class="t-mute">{w.what[lang]}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="tone-dark section edge closing">
  <a href={routes.contact[lang]} class="t-mega closing-title" data-contact-open>{copy.closeTitle}</a>
  <a href={routes.contact[lang]} class="btn btn-green" data-contact-open>{copy.closeCta}</a>
</section>

<style>
  .page-hero { min-height: 70svh; display: flex; flex-direction: column; justify-content: flex-end; gap: 1.25rem;
    padding-top: calc(var(--bar-h) + 3rem); padding-bottom: clamp(48px, 8vh, 96px); }
  .page-hero h1 { margin-left: -.04em; max-width: 12ch; }
  .page-hero .t-lead { max-width: 46ch; }
  .work-grid { display: grid; gap: clamp(56px, 7vw, 120px) var(--gutter); }
  @media (min-width: 800px) {
    .work-grid { grid-template-columns: 1fr 1fr; }
    .work-grid > :nth-child(even) { margin-top: 18vh; }
  }
  .more-head { grid-column: 1 / -1; display: grid; gap: 1rem; margin-bottom: 2rem; }
  .more-list { grid-column: 1 / -1; }
  .more-list li { display: grid; gap: .35rem 2rem; padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .more-list li:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) {
    .more-head { grid-column: 1 / 5; align-content: start; }
    .more-list { grid-column: 5 / -1; }
    .more-list li { grid-template-columns: 1fr 1fr; align-items: baseline; }
  }
  .closing { display: grid; gap: 2rem; justify-items: start; }
  .closing-title { margin-left: -.04em; max-width: 11ch; transition: color .4s var(--ease-out); }
  .closing-title:hover { color: var(--green); }
</style>
