---
import Logo from "./Logo.astro";
import { routes, navOrder, t, otherLang, type Lang, type PageKey } from "../i18n/ui";
import { whatsappUrl } from "../data/brand";

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const tr = t(lang);
const alt = otherLang(lang);
---
<header class="site-header" data-nav>
  <div class="container nav-inner">
    <a href={routes.home[lang]} class="logo" aria-label={`Bluz Creative, ${tr("nav.home")}`}>
      <Logo />
    </a>
    <nav class="site-nav" aria-label={tr("nav.main")}>
      {navOrder.map((key) => (
        <a href={routes[key][lang]} class:list={["nav-link", { "is-active": key === page }]} aria-current={key === page ? "page" : undefined}>
          {tr(`nav.${key}`)}
        </a>
      ))}
    </nav>
    <a href={routes[page][alt]} class="lang-switch" hreflang={alt} lang={alt} aria-label={tr("lang.switch")}>{alt.toUpperCase()}</a>
    <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary btn-sm nav-cta">{tr("cta.talk")}</a>
    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={tr("nav.open")}>
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <nav aria-label={tr("nav.mobile")}>
      {navOrder.map((key) => (
        <a href={routes[key][lang]} class:list={{ "is-active": key === page }}>{tr(`nav.${key}`)}</a>
      ))}
    </nav>
    <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary btn-block">{tr("cta.whatsapp")}</a>
  </div>
</header>
