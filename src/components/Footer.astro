---
import Logo from "./Logo.astro";
import { routes, navOrder, t, type Lang } from "../i18n/ui";
import { brand, whatsappUrl } from "../data/brand";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo label={brand.name} />
      <p>{tr("footer.tagline")}</p>
    </div>
    <nav class="footer-nav" aria-label={tr("footer.site")}>
      <span class="footer-heading">{tr("footer.site")}</span>
      {navOrder.map((key) => <a href={routes[key][lang]}>{tr(`nav.${key}`)}</a>)}
    </nav>
    <div class="footer-contact">
      <span class="footer-heading">{tr("footer.contact")}</span>
      <a href={brand.instagramUrl} target="_blank" rel="noopener">Instagram {brand.instagramHandle}</a>
      <a href={`mailto:${brand.email}`}>{brand.email}</a>
      <a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp {brand.whatsappDisplay}</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {brand.legalName}</p>
    <p>{tr("footer.location")}</p>
  </div>
</footer>
