---
// Pantalla de carga de la landing (inspirada en Studio Olimpo): nombre y contador de 0 a 100 sobre un recuadro
// donde se suceden imágenes de proyectos; al llegar a 100 el recuadro se abre a pantalla completa y da paso al hero.
// Se muestra una vez por sesión, nunca con movimiento reducido y nunca sin JavaScript.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { images: { src: ImageMetadata; alt: string }[] }
const { images } = Astro.props;
const frames = await Promise.all(images.map(async (i) => (await getImage({ src: i.src, width: 600, format: "webp" })).src));
---
<script is:inline>
  (function (d) {
    var seen = false;
    try { seen = sessionStorage.getItem("bluz-intro") === "1"; } catch (e) {}
    if (!seen && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      d.classList.add("intro");
      // Respaldo: si el script de la landing no arranca, la carga se retira sola
      setTimeout(function () { d.classList.remove("intro"); }, 7000);
    }
  })(document.documentElement);
</script>
<div class="loader" data-loader aria-hidden="true">
  <div class="loader-box" data-loader-box>
    <div class="loader-head">
      <span class="loader-name" data-loader-text>Bluz Creative</span>
      <span class="loader-count" data-loader-text><span data-loader-count>0</span></span>
    </div>
    <div class="loader-frame" data-loader-frame>
      {frames.map((src, i) => <img src={src} alt="" data-loader-img class:list={{ "is-on": i === 0 }} decoding="async" />)}
    </div>
  </div>
</div>

<style>
  .loader { display: none; }
  :global(html.intro) .loader {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 200; background: var(--black); color: var(--white);
  }
  :global(html.intro) { overflow: hidden; }
  .loader-box { width: min(64vw, 300px); display: grid; gap: .75rem; }
  .loader-head { display: flex; justify-content: space-between; align-items: baseline; overflow: hidden;
    font-size: .8125rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .loader-name, .loader-count { display: block; }
  .loader-count { font-variant-numeric: tabular-nums; color: var(--green); min-width: 3ch; text-align: right; }
  .loader-frame { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #161616; }
  .loader-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
  .loader-frame img.is-on { opacity: 1; }
</style>
