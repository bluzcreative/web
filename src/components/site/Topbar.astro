---
import Logo from "../Logo.astro";
import { routes, t, otherLang, type Lang } from "../../i18n/ui";

interface Props { lang: Lang; alternates?: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const tr = t(lang);
const alt = otherLang(lang);
const altHref = alternates ? alternates[alt] : routes.home[alt];
---
<header class="topbar" data-topbar>
  <a href={routes.home[lang]} class="topbar-logo" aria-label={tr("home.aria")}><Logo class="" /></a>
  <div class="topbar-actions">
    <!-- Cambio de idioma: el actual resaltado, el otro enlaza a la misma página traducida -->
    <nav class="topbar-lang" aria-label={lang === "es" ? "Idioma" : "Language"}>
      {(["es", "en"] as const).map((l) => l === lang
        ? <span aria-current="true">{l.toUpperCase()}</span>
        : <a href={altHref} hreflang={alt} lang={alt}>{l.toUpperCase()}</a>)}
    </nav>
    <!-- Sin JavaScript lleva a la página de contacto; con JavaScript abre el pop-up -->
    <a href={routes.contact[lang]} class="btn btn-green" data-contact-open>
      <span class="btn-label-long">{tr("cta.start")}</span><span class="btn-label-short" aria-hidden="true">{tr("cta.start.short")}</span>
    </a>
    <button class="topbar-menu" type="button" data-menu-open aria-controls="site-menu" aria-expanded="false" aria-label={tr("nav.open")}>
      <span>{tr("menu")}</span><i aria-hidden="true"></i>
    </button>
  </div>
</header>
