---
// Pop-up de contacto con dos caminos: formulario (Netlify Forms, "contacto") o WhatsApp.
// Se abre desde cualquier [data-contact-open]. En /contacto/ se renderiza abierto desde el servidor,
// así la URL funciona en anuncios, Instagram y firmas aunque el JavaScript no cargue.
import { routes, t, contactServices, type Lang } from "../../i18n/ui";
import { whatsappUrl } from "../../data/brand";

interface Props { lang: Lang; open?: boolean }
const { lang, open = false } = Astro.props;
const tr = t(lang);
---
<div class="contact tone-dark" id="contact" role="dialog" aria-modal="true" aria-labelledby="contact-title"
  data-contact data-standalone={open ? "" : undefined} hidden={!open}>
  <div class="contact-bar">
    <span class="t-label">{tr("contact.dialog")}</span>
    <button type="button" class="contact-close" data-contact-close aria-label={tr("close")}>
      <span>{tr("close")}</span><i aria-hidden="true"></i>
    </button>
  </div>

  <div class="contact-body">
    <div class="contact-side" data-contact-item>
      <h2 id="contact-title" class="t-mega contact-title">{tr("contact.title")}</h2>
      <a href={whatsappUrl(tr("contact.chat.message"))} target="_blank" rel="noopener" class="contact-chat">
        <span class="t-label">{tr("contact.chat.kicker")}</span>
        <span class="t-h2">{tr("contact.chat.title")} <span aria-hidden="true">↗</span></span>
        <span class="t-mute">{tr("contact.chat.note")}</span>
      </a>
    </div>

    <form class="contact-form" name="contacto" method="POST" action={routes.thanks[lang]}
      data-netlify="true" netlify-honeypot="bot-field" data-ajax-form data-lead-form data-contact-item>
      <input type="hidden" name="form-name" value="contacto">
      <input type="hidden" name="idioma" value={lang}>
      <input type="hidden" name="pagina" value="" data-page-field>
      <p class="hp" aria-hidden="true"><label>No llenar <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

      <div class="form-head">
        <span class="t-label">{tr("contact.form.kicker")}</span>
        <h3 class="t-h2">{tr("contact.form.title")}</h3>
      </div>

      <div class="form-body" data-form-body>
        <div class="fields">
          <label class="field">
            <span class="t-label">{tr("form.name")}</span>
            <input type="text" name="nombre" required autocomplete="name" placeholder={tr("form.name.ph")}>
          </label>
          <label class="field">
            <span class="t-label">{tr("form.email")}</span>
            <input type="email" name="email" required autocomplete="email" placeholder={tr("form.email.ph")}>
          </label>
          <label class="field">
            <span class="t-label">{tr("form.company")} <em>({tr("form.optional")})</em></span>
            <input type="text" name="empresa" autocomplete="organization" placeholder={tr("form.company.ph")}>
          </label>
          <label class="field">
            <span class="t-label">{tr("form.site")} <em>({tr("form.optional")})</em></span>
            <input type="text" name="web_o_instagram" inputmode="url" placeholder={tr("form.site.ph")}>
          </label>
        </div>

        <fieldset class="field chips">
          <legend class="t-label">{tr("form.services")}</legend>
          <div class="chips-list">
            {contactServices.map((s) => (
              <label class="chip"><input type="checkbox" name={`servicio_${s.key}`} value="si"><span>{s[lang]}</span></label>
            ))}
          </div>
        </fieldset>

        <label class="field">
          <span class="t-label">{tr("form.message")}</span>
          <textarea name="mensaje" rows="4" required placeholder={tr("form.message.ph")}></textarea>
        </label>

        <div class="form-submit">
          <button type="submit" class="btn btn-green" data-submit-label={tr("form.send")} data-sending-label={tr("form.sending")}>{tr("form.send")}</button>
          <p class="t-mute form-legal">{tr("form.legal")} <a href={routes.privacy[lang]}>{tr("form.legal.link")}</a>.</p>
        </div>
        <p class="form-error" data-form-error hidden role="alert">{tr("form.error")}</p>
      </div>

      <div class="form-ok" data-form-ok hidden tabindex="-1">
        <p class="t-h1">{tr("form.ok.title")}</p>
        <p class="t-lead t-mute">{tr("form.ok.text")}</p>
      </div>
    </form>
  </div>
</div>

<style>
  .contact {
    position: fixed; inset: 0; z-index: 90; overflow-y: auto; overscroll-behavior: contain;
    padding: 0 var(--edge) var(--edge);
  }
  .contact[hidden] { display: none; }
  .contact-bar { position: sticky; top: 0; z-index: 2; height: var(--bar-h); display: flex; align-items: center; background: var(--surface); }
  .contact-close { margin-left: auto; display: inline-flex; align-items: center; gap: .55rem; font-weight: 600; font-size: .9375rem; padding: .7rem .2rem; }
  .contact-close i { position: relative; width: 22px; height: 22px; }
  .contact-close i::before, .contact-close i::after { content: ""; position: absolute; left: 0; top: 50%; width: 22px; height: 2px; background: currentColor; }
  .contact-close i::before { transform: rotate(45deg); }
  .contact-close i::after { transform: rotate(-45deg); }

  .contact-body { display: grid; gap: clamp(40px, 6vw, 96px); padding-top: clamp(16px, 4vh, 48px); }
  .contact-side { display: grid; gap: clamp(24px, 4vw, 48px); align-content: start; }
  .contact-title { font-size: clamp(3.4rem, 13vw, 7rem); }
  @media (min-width: 1000px) { .contact-title { font-size: clamp(5rem, 7.2vw, 9rem); } }

  .contact-chat {
    display: grid; gap: .6rem; padding: clamp(20px, 2.4vw, 36px); border: 1px solid var(--line);
    transition: background-color .35s var(--ease-out), color .35s var(--ease-out), border-color .35s var(--ease-out);
  }
  .contact-chat:hover { background: var(--green); color: var(--black); border-color: var(--green); }
  .contact-chat:hover .t-label, .contact-chat:hover .t-mute { color: rgba(10,10,10,.7); }

  .contact-form { display: grid; gap: 2rem; align-content: start; }
  .form-head { display: grid; gap: .6rem; }
  .form-body { display: grid; gap: 1.75rem; }
  .fields { display: grid; gap: 1.75rem var(--gutter); }
  @media (min-width: 700px) { .fields { grid-template-columns: 1fr 1fr; } }

  .field { display: grid; gap: .5rem; border: 0; padding: 0; min-width: 0; }
  .field em { font-style: normal; text-transform: none; letter-spacing: 0; font-weight: 400; }
  .field input, .field textarea {
    width: 100%; background: rgba(255,255,255,.04); color: var(--text); font: inherit; font-size: 1.0625rem;
    border: 1px solid var(--line); border-radius: 10px; padding: .9rem 1rem; outline: none;
    transition: border-color .25s var(--ease-out), background-color .25s var(--ease-out);
  }
  .field input::placeholder, .field textarea::placeholder { color: #6b6b6b; }
  .field input:hover, .field textarea:hover { border-color: rgba(255,255,255,.28); }
  .field input:focus, .field textarea:focus { border-color: var(--green); background: rgba(123,255,118,.05); }
  .field textarea { resize: vertical; min-height: 8rem; line-height: 1.5; }
  .field input:-webkit-autofill { -webkit-text-fill-color: var(--text); -webkit-box-shadow: 0 0 0 100px #161616 inset; }

  .chips legend { margin-bottom: .75rem; }
  .chips-list { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span {
    display: inline-block; padding: .6em 1.05em; border: 1px solid var(--line); border-radius: 999px;
    font-size: .9375rem; cursor: pointer; user-select: none;
    transition: background-color .2s var(--ease-out), color .2s var(--ease-out), border-color .2s var(--ease-out);
  }
  .chip span:hover { border-color: var(--text); }
  .chip input:checked + span { background: var(--green); color: var(--black); border-color: var(--green); }
  .chip input:focus-visible + span { outline: 2px solid var(--green); outline-offset: 3px; }

  .form-submit { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .form-legal { font-size: .875rem; }
  .form-legal a { text-decoration: underline; text-underline-offset: .2em; }
  .form-error { color: #ff8a7a; }
  .form-ok { display: grid; gap: 1rem; padding-block: 2rem; outline: none; }
  .form-ok .t-h1 { color: var(--green); }
  .hp { position: absolute; left: -9999px; }

  @media (min-width: 1000px) {
    .contact-body { grid-template-columns: 5fr 7fr; }
    .contact-side { position: sticky; top: var(--bar-h); }
  }
</style>
