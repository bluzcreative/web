---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { routes, languages, t, type Lang, type PageKey } from "../i18n/ui";

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const tr = t(lang);
---
<!doctype html>
<html lang={lang}>
<head>
<script is:inline>
  // Las animaciones ocultan contenido antes de mostrarlo. Si el JavaScript principal
  // no llega a arrancar en 2.5 s, se muestra todo para que la página siempre se lea.
  (function (d) {
    d.classList.add("js");
    setTimeout(function () { if (!d.classList.contains("is-ready")) d.classList.add("no-anim"); }, 2500);
  })(document.documentElement);
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{(Object.keys(languages) as Lang[]).map((l) => (
  <link rel="alternate" hreflang={l} href={routes[page][l]} />
))}
<link rel="alternate" hreflang="x-default" href={routes[page].es} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Fraunces:ital,wght@1,400;1,500&family=Inter:wght@400;500;600;700&display=swap">
</head>
<body>
<a href="#main" class="skip-link">{tr("skip")}</a>
<Header lang={lang} page={page} />
<main id="main">
  <slot />
</main>
<Footer lang={lang} />
<script>
  import "../scripts/main.js";
</script>
</body>
</html>
