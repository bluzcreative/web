---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import Loader from "../../components/site/Loader.astro";
import Home from "../../views/Home.astro";

const loaderImages = (await getCollection("projects", (p) => p.data.featured && !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 4)
  .map((p) => ({ src: p.data.cover, alt: p.data.coverAlt.en }));
---
<Site lang="en" page="home" title="Bluz Creative | Paid media, content, web and automations" description="Bluz Creative is a marketing agency working with brands worldwide: paid media, content strategy, web design and automations.">
  <Loader slot="before" images={loaderImages} />
  <Home lang="en" />
</Site>
