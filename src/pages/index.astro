---
import Site from "../layouts/Site.astro";
import { loaderImages } from "../lib/loader-images";
import Loader from "../components/site/Loader.astro";
import Home from "../views/Home.astro";

const images = await loaderImages("es");
---
<Site lang="es" page="home" title="Bluz Creative | Contenido, branding, audiovisual, web y automatizaciones" description="Bluz Creative es una agencia de marketing con clientes en todo el mundo: estrategia de contenido, branding y diseño, producción audiovisual, diseño web, automatizaciones y paid media.">
  <Loader slot="before" images={images} />
  <Home lang="es" />
</Site>
