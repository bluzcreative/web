---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import Project from "../../views/Project.astro";
import { projectUrl } from "../../i18n/ui";

export async function getStaticPaths() {
  const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
  // "Siguiente" recorre solo los proyectos visibles en "Todo"; los que solo aparecen con un filtro llevan al primero
  const listed = projects.filter((p) => !p.data.onlyInFilters);
  return projects.map((project) => {
    const i = listed.indexOf(project);
    return { params: { slug: project.id }, props: { project, next: listed[(i + 1) % listed.length] } };
  });
}

const { project, next } = Astro.props;
const d = project.data;
---
<Site lang="es" page="work" alternates={{ es: projectUrl("es", project.id), en: projectUrl("en", project.id) }}
  title={`${d.client} | Bluz Creative`} description={d.summary.es} image={d.cover}>
  <Project project={project} next={next} lang="es" />
</Site>
